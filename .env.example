# Alpaca paper trading.
# LOCAL .env  -> keys for the TESTING account "Paper Trading" PA3TQHQKM5AD (all dev runs here).
# GitHub Actions secrets -> keys for the COMPETITION account "PAPER UC3M" PA39HSCQE8S3
#   (each paper account has its own key pair; generate UC3M's after switching account in the dashboard).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Leave paper as default. Do NOT set ALPACA_LIVE_TRADE.
ALPACA_PAPER=true

# Alpaca data API base (paper keys work for market data)
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Competition account id — goes in the final submission
ALPACA_ACCOUNT_ID=PA39HSCQE8S3

# Featherless AI — redeem coupon ALPACA26 at featherless.ai for $25 credits (256K ctx, any model size)
# OpenAI-compatible endpoint. This is the ONLY LLM provider — Anthropic was dropped (no
# out-of-pocket spend), so all four seats (Quant ensemble + Bull/Bear/Desk Head) run here.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Comma-separated open model ids for the Quant ensemble (pick 3, good JSON-following)
FEATHERLESS_MODELS=
# Modelo para Bull/Bear/Desk Head. Vacío = usa el primero de FEATHERLESS_MODELS.
FEATHERLESS_ARGUER_MODEL=

# Runtime
DESK_MODE=dry_run          # dry_run | live | exits_only  (exits_only = kill switch: manage book, open nothing)
# Capa LLM (la mesa). `required` = sin claves no se abre nada; `off` = pasa la decisión
# determinista tal cual. `off` es el escape si Featherless se cae en sesión.
DESK_DEBATE=required       # required | off
DESK_DEBATE_BUDGET_S=90    # techo de reloj para todo el debate; el cron es de 15 min
# Sizing NO se toca por env: `risk_per_trade` vive en agent/config.py (0.5% NAV plano, decisión #16).
# Para un cambio en caliente durante la sesión, editar data/params.json (ver docs/RUNBOOK.md).
