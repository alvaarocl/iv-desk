# Alpaca paper trading — FRESH dedicated account for the hackathon
# Create at https://app.alpaca.markets/paper/dashboard/overview  → set balance to $100,000 → enable options Level 3
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Leave paper as default. Do NOT set ALPACA_LIVE_TRADE.
ALPACA_PAPER=true

# Alpaca data API base (paper keys work for market data)
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# The paper account ID (from the dashboard) — needed for the final submission
ALPACA_ACCOUNT_ID=

# Featherless AI — claim $25 credits from the hackathon partner page (first-come-first-served)
# OpenAI-compatible endpoint
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Comma-separated open model ids for the Quant ensemble (pick 3)
FEATHERLESS_MODELS=

# Anthropic — Bull/Bear/Desk Head seats
ANTHROPIC_API_KEY=

# Runtime
DESK_MODE=dry_run          # dry_run | live
DESK_RISK_PER_TRADE=0.005  # fraction of NAV; 0.005 during Day-3 ramp, 0.01-0.02 after
