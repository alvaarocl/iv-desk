# Alpaca paper trading.
# LOCAL .env  -> keys for the TESTING account "Paper Trading" PA3TQHQKM5AD (all dev runs here).
# GitHub Actions secrets -> keys for the COMPETITION account "PAPER UC3M" PA39HSCQE8S3
#   (each paper account has its own key pair; generate UC3M's after switching account in the dashboard).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Leave paper as default. Do NOT set ALPACA_LIVE_TRADE.
ALPACA_PAPER=true

# Alpaca data API base (paper keys work for market data)
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Competition account id — goes in the final submission
ALPACA_ACCOUNT_ID=PA39HSCQE8S3

# Featherless AI — redeem coupon ALPACA26 at featherless.ai for $25 credits (256K ctx, any model size)
# OpenAI-compatible endpoint
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Comma-separated open model ids for the Quant ensemble (pick 3)
FEATHERLESS_MODELS=

# Anthropic — Bull/Bear/Desk Head seats
ANTHROPIC_API_KEY=

# Runtime
DESK_MODE=dry_run          # dry_run | live
DESK_RISK_PER_TRADE=0.005  # fraction of NAV; 0.005 during Day-3 ramp, 0.01-0.02 after
